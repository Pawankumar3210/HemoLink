# Copy to .env and fill in. Never commit .env. Every value below is a placeholder.

# --- Application -------------------------------------------------------------
# development | production | testing
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
FLASK_DEBUG=1
# Public site address, used to build password-reset links (recommended in production)
PUBLIC_BASE_URL=
# Number of reverse proxies in front of the app (1 on Render/Railway, 0 locally)
TRUST_PROXY_HOPS=0
SESSION_HOURS=8
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ----------------------------------------------------------------
# Local (non-Docker) MySQL:
DATABASE_URL=mysql+pymysql://hemolink:change-me@localhost:3306/hemolink?charset=utf8mb4
# Used only by the test suite. The database name MUST contain "test": tests drop tables.
# Leave unset (default) to run the suite on in-memory SQLite. Uncomment for MySQL tests.
# TEST_DATABASE_URL=mysql+pymysql://hemolink:change-me@localhost:3306/hemolink_test?charset=utf8mb4
# For managed databases that require TLS, path to a CA bundle, e.g.
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DB_SSL_CA=

# --- Docker Compose (used by docker-compose.yml) ------------------------------
# Use URL-safe passwords (letters and digits): they are placed inside DATABASE_URL.
MYSQL_DATABASE=hemolink
MYSQL_USER=hemolink
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
WEB_PORT=8000
# Set to 1 to run `flask db upgrade` when the container starts (local convenience).
RUN_MIGRATIONS=1
ALLOW_DEMO_SEED=true

# --- Email (password reset) --------------------------------------------------
# Leave MAIL_SERVER empty in development: reset links go to the log and /dev/outbox.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=HemoLink <no-reply@example.com>
PASSWORD_RESET_MINUTES=30

# --- Optional ----------------------------------------------------------------
# Password for `flask create-admin` in non-interactive environments only.
# HEMOLINK_ADMIN_PASSWORD=
# Password for `flask seed-demo` (random if unset).
# DEMO_PASSWORD=
